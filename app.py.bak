from flask import Flask, render_template, request, redirect, session, jsonify
import requests, threading, time, sqlite3, datetime
from db import init_db

app = Flask(__name__)
app.secret_key = "supersecretkey"

init_db()

# 🔁 MONITOR LOOP
def monitor_loop():
    while True:
        conn = sqlite3.connect("monitor.db")
        c = conn.cursor()

        monitors = c.execute("SELECT * FROM monitors").fetchall()
        now = time.time()

        for m in monitors:
            id, url, old_status, response_time, interval, last_check = m

            if last_check is None or now - last_check >= interval:
                try:
                    start = time.time()
                    r = requests.get(url, timeout=10)
                    response_time = round(time.time() - start, 2)
                    status = "UP" if r.status_code == 200 else "DOWN"
                except:
                    status = "DOWN"
                    response_time = 0

                c.execute("""
                UPDATE monitors 
                SET status=?, response_time=?, last_check=? 
                WHERE id=?
                """, (status, response_time, now, id))

                c.execute("""
                INSERT INTO logs (url, status, time)
                VALUES (?, ?, ?)
                """, (url, status, str(datetime.datetime.now())))

        conn.commit()
        conn.close()
        time.sleep(5)

threading.Thread(target=monitor_loop, daemon=True).start()

# 🔐 LOGIN
@app.route("/", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        u = request.form["username"]
        p = request.form["password"]

        conn = sqlite3.connect("monitor.db")
        c = conn.cursor()
        user = c.execute("SELECT * FROM users WHERE username=? AND password=?", (u, p)).fetchone()
        conn.close()

        if user:
            session["user"] = u
            return redirect("/dashboard")

    return render_template("login.html")

# 📝 REGISTER
@app.route("/register", methods=["GET", "POST"])
def register():
    error = None
    if request.method == "POST":
        u = request.form["username"]
        p = request.form["password"]

        conn = sqlite3.connect("monitor.db")
        c = conn.cursor()
        existing = c.execute("SELECT * FROM users WHERE username=?", (u,)).fetchone()
        if existing:
            conn.close()
            error = "❌ User already exists!"
            return render_template("register.html", error=error)

        c.execute("INSERT INTO users (username, password) VALUES (?, ?)", (u, p))
        conn.commit()
        conn.close()
        return redirect("/")
    return render_template("register.html", error=error)

# 📊 DASHBOARD
@app.route("/dashboard")
def dashboard():
    if "user" not in session:
        return redirect("/")
    return render_template("dashboard.html")

# ➕ ADD (SAFE)
@app.route("/add", methods=["POST"])
def add():
    if "user" not in session:
        return redirect("/")

    try:
        url = request.form.get("url")
        interval = request.form.get("interval")

        if not url:
            return "URL required!"

        if not interval:
            interval = 60

        interval = int(interval)

        conn = sqlite3.connect("monitor.db")
        c = conn.cursor()

        c.execute("""
        INSERT INTO monitors (url, status, response_time, interval, last_check)
        VALUES (?, ?, ?, ?, ?)
        """, (url, "Checking", 0, interval, 0))

        conn.commit()
        conn.close()

        return redirect("/dashboard")

    except Exception as e:
        return f"Error: {str(e)}"

# ❌ DELETE
@app.route("/delete/<int:id>")
def delete(id):
    if "user" not in session:
        return redirect("/")

    conn = sqlite3.connect("monitor.db")
    c = conn.cursor()
    c.execute("DELETE FROM monitors WHERE id=?", (id,))
    conn.commit()
    conn.close()

    return redirect("/dashboard")

# 📡 API
@app.route("/api/monitors")
def api_monitors():
    conn = sqlite3.connect("monitor.db")
    c = conn.cursor()
    data = c.execute("SELECT * FROM monitors").fetchall()
    conn.close()
    return jsonify(data)

# 📜 LOGS
@app.route("/api/logs")
def logs():
    conn = sqlite3.connect("monitor.db")
    c = conn.cursor()
    data = c.execute("SELECT * FROM logs ORDER BY id DESC LIMIT 50").fetchall()
    conn.close()
    return jsonify(data)

# 🚀 RUN
if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)